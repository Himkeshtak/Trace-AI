POSTGRES_DB=traceai
POSTGRES_USER=traceai
POSTGRES_PASSWORD=traceai_dev_password
DATABASE_URL=postgresql://traceai:traceai_dev_password@postgres:5432/traceai

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=trace-events
KAFKA_CONSUMER_GROUP=traceai-storage

REDIS_URL=redis://redis:6379/0
ANALYTICS_CACHE_TTL_SECONDS=30

AIRFLOW_DB=airflow
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow_dev_password
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin

API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000/api/v1

